# Postgres (Supabase). For local dev you can fall back to SQLite (see config.py).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/domestique
# Leave unset to use a local SQLite file (domestique.sqlite3) for quick start.

# Web push (VAPID) — generate with: python -m app.notify generate-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# CORS origin for the frontend
FRONTEND_ORIGIN=http://localhost:5173
